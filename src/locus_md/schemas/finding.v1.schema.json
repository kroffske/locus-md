{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.locus-md.dev/finding.v1.schema.json",
  "title": "locus-md Finding v1",
  "description": "The serialized shape returned by Finding.to_dict().",
  "type": "object",
  "required": ["code", "message", "severity"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^(?:[A-Z][A-Z0-9-]*|[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+)$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": ["info", "warning", "error", "fatal"]
    },
    "path": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "column": {
      "type": "integer",
      "minimum": 1
    },
    "surface": {
      "type": "string"
    },
    "contract_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "passed",
        "unverified",
        "failed",
        "configuration-error",
        "internal-error"
      ]
    },
    "details": {
      "type": "object"
    },
    "remediation": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["command", "config", "manual"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
