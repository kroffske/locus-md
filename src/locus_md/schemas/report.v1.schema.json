{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.locus-md.dev/report.v1.schema.json",
  "title": "locus-md Report v1",
  "description": "The public payload returned by Report.to_dict() for lint, verify, and sync commands.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "mode",
    "state",
    "config_digest",
    "config_path",
    "snapshots",
    "findings",
    "patches",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "locus-md.report.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": ["lint", "verify", "sync-check", "sync-write"]
    },
    "state": {
      "enum": ["passed", "failed", "unverified", "configuration-error", "internal-error"]
    },
    "config_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_path": {
      "type": "string"
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.locus-md.dev/finding.v1.schema.json"
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/patch"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "lint"}}
      },
      "then": {
        "properties": {
          "metadata": {
            "required": ["document_count", "block_count"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"const": "verify"}}
      },
      "then": {
        "properties": {
          "metadata": {
            "required": [
              "document_count",
              "contract_count",
              "rule_invocation_count",
              "rules",
              "offline"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {"mode": {"enum": ["sync-check", "sync-write"]}}
      },
      "then": {
        "properties": {
          "metadata": {
            "required": ["contract_count", "rule_invocation_count", "rules", "offline", "write"]
          }
        }
      }
    }
  ],
  "$defs": {
    "ruleProvenance": {
      "type": "object",
      "required": ["rule", "adapter", "plugin_id", "plugin_version", "invocation_count"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "plugin_id": {"type": "string", "minLength": 1},
        "plugin_version": {"type": "string", "minLength": 1},
        "invocation_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "document_count": {"type": "integer", "minimum": 0},
        "block_count": {"type": "integer", "minimum": 0},
        "contract_count": {"type": "integer", "minimum": 0},
        "rule_invocation_count": {"type": "integer", "minimum": 0},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleProvenance"}
        },
        "offline": {"type": "boolean"},
        "write": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": [
        "path",
        "start",
        "end",
        "original_digest",
        "replacement_digest",
        "contract_id",
        "description",
        "diff"
      ],
      "properties": {
        "path": {"type": "string"},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "original_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "replacement_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "contract_id": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "diff": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
